<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/back">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Заголовок -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/blur_background"
            android:padding="12dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Список задач"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000000" />

        </RelativeLayout>

        <!-- Переключатели списков -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:weightSum="3">

            <Button
                android:id="@+id/buttonTasks"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Задачи"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_category_selected" />

            <Button
                android:id="@+id/buttonNotUrgent"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="Не срочные"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_category_default" />

            <Button
                android:id="@+id/buttonShopping"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Покупки"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_category_default" />

        </LinearLayout>

        <!-- Только для покупок -->
        <Button
            android:id="@+id/clearAllButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сбросить всё"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <ListView
            android:id="@+id/itemsListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:padding="4dp" />

        <Button
            android:id="@+id/addTriggerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добавить"
            style="@style/RoundedButton"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- Оверлей добавления элемента: отцентрован по экрану, клавиатура его не перекрывает -->
    <FrameLayout
        android:id="@+id/addOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            android:background="@drawable/blur_background"
            android:padding="20dp"
            android:clickable="true"
            android:focusable="true">

            <EditText
                android:id="@+id/itemInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Введите текст"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:background="@android:color/white"
                android:padding="12dp"
                android:textColor="#000000"
                android:textColorHint="#666666" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/addCancelButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Отмена" />

                <Button
                    android:id="@+id/addConfirmButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Добавить"
                    style="@style/RoundedButton" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>